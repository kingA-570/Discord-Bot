# Copy this file to .env (or export these as real environment variables)
# and NEVER commit the filled-in version.

# --- Discord ---
DISCORD_BOT_TOKEN=your-bot-token-here
# Optional: set during development for instant (per-guild) slash command sync.
# Leave blank for global commands (can take up to ~1 hour to propagate).
DISCORD_DEV_GUILD_ID=

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/domistats_bot
DB_USERNAME=postgres
DB_PASSWORD=change-me

# --- DomiStats scraping ---
DOMISTATS_BASE_URL=https://domistats.com
DOMISTATS_MIN_INTERVAL_MS=2000
DOMISTATS_SCAN_INTERVAL_MS=60000
DOMISTATS_ALLIANCE_CACHE_TTL=60
DOMISTATS_SPINNING_CACHE_TTL=30
DOMISTATS_USER_AGENT=DomiStatsWarRadarBot/1.0 (+contact: your-email@example.com)
